# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/roommatch

# ---- Auth ----
# 32+ random characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Saved-property reminder delay (minutes)
SAVED_REMINDER_MINUTES=5

# ---- Email OTP via Brevo SMTP ----
# Brevo dashboard -> SMTP & API -> SMTP tab
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# The "Login" shown on that page (looks like xxxxxx@smtp-brevo.com), NOT your account email
SMTP_USER=
# An SMTP key you generate there (NOT your Brevo password, NOT the v3 API key)
SMTP_PASS=
# Must be a sender you verified in Brevo (Senders, Domains & Dedicated IPs -> Senders)
MAIL_FROM="RoomMatch <your-verified-sender@example.com>"

# Demo account inboxes (use four distinct email addresses you control).
# Demo accounts are NOT pre-verified: each must complete the normal Brevo OTP flow.
DEMO_TENANT_EMAIL=
DEMO_LANDLORD1_EMAIL=
DEMO_LANDLORD2_EMAIL=
DEMO_LANDLORD3_EMAIL=
